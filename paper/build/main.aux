\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces AttentionHub-v1 versus AttentionHub-v2. \emph  {Left:} the v1 hub fuses BAM, Triplet, and KAN-Attention in parallel, concatenating their channel-reduced branch outputs before a $1\times 1$ projection. \emph  {Right:} the proposed v2 hub composes Triplet Attention and SE sequentially. The two hubs reuse the same building blocks but differ in composition; Section~\ref {sec:ablation} shows that the difference in composition is what separates their accuracy.}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:v1v2}{{6}{11}{AttentionHub-v1 versus AttentionHub-v2. \emph {Left:} the v1 hub fuses BAM, Triplet, and KAN-Attention in parallel, concatenating their channel-reduced branch outputs before a $1\times 1$ projection. \emph {Right:} the proposed v2 hub composes Triplet Attention and SE sequentially. The two hubs reuse the same building blocks but differ in composition; Section~\ref {sec:ablation} shows that the difference in composition is what separates their accuracy}{figure.6}{}}
